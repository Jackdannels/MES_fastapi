g {\r\n  appearance: none;\r\n  border: 1px solid rgba(56, 189, 248, 0.42);\r\n  background: rgba(56, 189, 248, 0.16);\r\n  border-radius: 999px;\r\n  padding: 3px 10px;\r\n  font-size: 12px;\r\n  color: var(--text);\r\n  cursor: pointer;\r\n}\r\n\r\n.sample-tray-sample-tag:active {\r\n  cursor: grabbing;\r\n}\r\n\r\n.sample-tray-empty {\r\n  font-size: 12px;\r\n  color: var(--muted);\r\n}\r\n\r\n/* 托盘底部控制区用于容量显示与删除操作。 */\r\n.sample-tray-card-controls {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  gap: 8px;\r\n  align-items: center;\r\n}\r\n\r\n.sample-tray-capacity {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  font-size: 12px;\r\n  color: var(--text);\r\n  padding: 6px 10px;\r\n  border-radius: 8px;\r\n  border: 1px solid rgba(15, 23, 42, 0.16);\r\n  background: rgba(248, 250, 252, 0.95);\r\n}\r\n\r\n.sample-tray-remove {\r\n  border: 1px solid rgba(244, 63, 94, 0.4);\r\n  background: rgba(244, 63, 94, 0.1);\r\n  color: var(--text);\r\n  border-radius: 8px;\r\n  padding: 6px 8px;\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n}\r\n\r\n.sample-process-actions {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n}\r\n\r\n.sample-process-layout.is-compact-outbound .sample-process-actions {\r\n  align-items: stretch;\r\n}\r\n\r\n.sample-outbound-panel {\r\n  margin-left: auto;\r\n  width: min(620px, 100%);\r\n  display: grid;\r\n  gap: 12px;\r\n  padding: 14px 16px;\r\n  border: 1px solid rgba(15, 23, 42, 0.12);\r\n  border-radius: 14px;\r\n  background: rgba(248, 250, 252, 0.9);\r\n}\r\n\r\n.sample-process-layout.is-compact-outbound .sample-outbound-panel {\r\n  width: min(760px, 100%);\r\n}\r\n\r\n.sample-outbound-panel-head {\r\n  display: grid;\r\n  gap: 4px;\r\n}\r\n\r\n.sample-outbound-panel-title {\r\n  font-size: 15px;\r\n  font-weight: 700;\r\n}\r\n\r\n.sample-outbound-panel-subtitle {\r\n  font-size: 12px;\r\n  color: var(--muted);\r\n}\r\n\r\n.sample-outbound-fiel