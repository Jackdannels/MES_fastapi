{
  "name": "MES与上位机MQTT接口定义",
  "version": "2.5",
  "encoding": "UTF-8",
  "payloadFormat": "JSON",
  "timeFormat": "北京时间 YYYY-MM-DD HH:mm:ss",
  "topicPrefix": "mes/v1",
  "laboratoryInterfaceExceptions": {
    "LAB_HOT_HUMID_2": {
      "hostless": ["INSTALL_FIXTURE", "FIXTURE_READY"],
      "mqtt": ["READY", "EXPERIMENT_STARTED", "END_REQUEST", "EXPERIMENT_ENDED"]
    }
  },
  "send": [
    {
      "name": "安装夹具，校验信息",
      "direction": "MES_TO_HOST",
      "topic": "mes/v1/labs/{lab_code}/commands/fixture-install",
      "payload": {
        "task_code": "任务编号",
        "lab_code": "试验间编码",
        "sample_type": "样品类型",
        "sample_count": 0
      }
    },
    {
      "name": "实验准备就绪",
      "direction": "MES_TO_HOST",
      "topic": "mes/v1/labs/{lab_code}/commands/experiment-ready",
      "payload": {
        "task_code": "任务编号",
        "lab_code": "试验间编码",
        "experiment_code": "实验编号",
        "run_no": "MES实验运行批次号；轴向接续沿用原值",
        "sub_experiment_code": "轴向分段实验编号，非轴向省略",
        "axis_codes": ["x+", "x-", "y+"],
        "current_axis_code": "本次准备启动的轴向，非轴向省略"
      }
    },
    {
      "name": "请求结束实验",
      "direction": "MES_TO_HOST",
      "topic": "mes/v1/labs/{lab_code}/commands/experiment-end-request",
      "payload": {
        "task_code": "任务编号",
        "lab_code": "试验间编码",
        "experiment_code": "实验编号",
        "run_no": "MES实验运行批次号",
        "sub_experiment_code": "轴向分段实验编号，非轴向省略",
        "axis_code": "当前轴向，非轴向省略",
        "next_axis_code": "下一轴向，最终轴向省略",
        "end_mode": "正常完成省略；霉菌专用取消为 cancel；所有实验室的设备故障取消为 device_fault_cancel（与盐雾暂停/停止独立）",
        "cancel_reason": "cancel 或 device_fault_cancel 时必填的取消原因",
        "cancel_request_id": "cancel 或 device_fault_cancel 时由 MES 生成的取消请求标识"
      }
    }
  ],
  "receive": [
    {
      "name": "7号屏试验间状态遥测快照",
      "direction": "HOST_TO_MES",
      "topic": "mes/v1/labs/{lab_code}/telemetry/snapshot",
      "qos": 1,
      "intervalSeconds": 1,
      "delayedAfterSeconds": 5,
      "offlineAfterSeconds": 15,
      "recoveryFreshSamples": 2,
      "payload": {
        "schema_version": "1.0",
        "message_id": "UUID",
        "source_id": "upper-LAB_IMPACT_1",
        "boot_id": "UUID",
        "sequence": 1,
        "lab_code": "试验间编码",
        "observed_at": "2026-09-16T14:30:05+08:00",
        "collector_status": "online",
        "cycle": 1,
        "alarms": [],
        "environment": {"temperature_c": 23.6, "humidity_rh": 51.2, "quality": "good"},
        "test_device": {"configured": true, "online": true, "observed_at": "2026-09-16T14:30:05+08:00", "temperature_c": 38.4, "voltage_v": 220.7, "alarm_code": null},
        "carrier_device": {"configured": true, "online": true, "observed_at": "2026-09-16T14:30:05+08:00", "temperature_c": 31.2, "voltage_v": 223.1, "alarm_code": null}
      }
    },
    {
      "name": "夹具安装完成",
      "direction": "HOST_TO_MES",
      "topic": "mes/v1/labs/{lab_code}/events/fixture-ready",
      "payload": {
        "lab_code": "试验间编码",
        "success_id": "成功标识",
        "fixture_ready_at": "2026-05-16 09:31:00"
      }
    },
    {
      "name": "实验开始",
      "direction": "HOST_TO_MES",
      "topic": "mes/v1/labs/{lab_code}/events/experiment-started",
      "payload": {
        "lab_code": "试验间编码",
        "run_no": "MES实验运行批次号",
        "sub_experiment_code": "轴向分段实验编号，非轴向省略",
        "current_axis_code": "本次实际启动的轴向，非轴向省略",
        "started_at": "2026-05-16 10:00:00"
      }
    },
    {
      "name": "实验结束",
      "direction": "HOST_TO_MES",
      "topic": "mes/v1/labs/{lab_code}/events/experiment-ended",
      "payload": {
        "lab_code": "试验间编码",
        "run_no": "MES下发的实验运行批次号",
        "sub_experiment_code": "轴向任务的分段实验编号，非轴向省略",
        "axis_code": "本次完成轴向，非轴向省略",
        "next_axis_code": "下一轴向，最终轴向省略",
        "end_mode": "正常完成省略；确认霉菌取消原样返回 cancel；确认设备故障取消原样返回 device_fault_cancel",
        "cancel_request_id": "确认取消时必须原样返回 MES 下发的取消请求标识；设备安全停止前不得发送取消确认，结果可独立通过 experiment-result 补传到原 run_no",
        "ended_at": "2026-05-16 17:30:00"
      }
    },
    {
      "name": "实验结果",
      "direction": "HOST_TO_MES",
      "topic": "mes/v1/labs/{lab_code}/events/experiment-result",
      "payload": {
        "lab_code": "试验间编码",
        "result_at": "2026-05-16 17:31:00",
        "result_package": {
          "conclusion": "PASS",
          "summary": "实验结果正常",
          "files": []
        }
      }
    }
  ]
}
