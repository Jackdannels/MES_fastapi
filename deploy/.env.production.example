COMPOSE_PROJECT_NAME=mes-production

# Publish immutable images as tag@sha256:digest. Floating tags are rejected by preflight.
MES_API_IMAGE=registry.example.com/mes/api:1.0.0@sha256:replace-with-64-hex-characters
MES_WEB_IMAGE=registry.example.com/mes/web:1.0.0@sha256:replace-with-64-hex-characters

MES_DOMAIN=mes.example.com
MES_HTTP_PORT=80
MES_HTTPS_PORT=443

# Bounded Docker json-file logs for migrate, API, and Web containers.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Existing external infrastructure. No MySQL or broker container is created.
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_DATABASE=mes_single_branch
MYSQL_API_USER=mes_api
MYSQL_MIGRATION_USER=mes_migrator

MQTT_HOST=mq.example.internal
MQTT_PORT=1883
MQTT_USERNAME=mes_app
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_PUBLISH_TIMEOUT_SECONDS=10
MQTT_PUBLISH_SLOW_MS=250

CAPACITY_WARN_POOL_UTILIZATION=0.8
CAPACITY_WARN_STAGING_EVENT_ITEMS=20000
CAPACITY_WARN_STAGING_EVENT_BYTES=16777216
CAPACITY_WARN_MQ_MESSAGE_ROWS=500000
CAPACITY_WARN_EXPERIMENT_EVENT_ROWS=500000

RETENTION_ENABLED=true
RETENTION_STARTUP_DELAY_SECONDS=60
RETENTION_INTERVAL_SECONDS=3600
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES_PER_RUN=10
MQ_MESSAGE_LOG_RETENTION_DAYS=90
EXPERIMENT_EVENT_RETENTION_DAYS=365
STAGING_EVENT_RETENTION_DAYS=365

# Files must exist only on the deployment host and must not be committed.
MYSQL_API_PASSWORD_FILE=./.tmp/production-secrets/mysql_api_password
MYSQL_MIGRATION_PASSWORD_FILE=./.tmp/production-secrets/mysql_migration_password
MYSQL_CA_CERTIFICATE_FILE=./.tmp/production-secrets/mysql_ca.pem
RABBITMQ_URL_FILE=./.tmp/production-secrets/rabbitmq_url
MQTT_PASSWORD_FILE=./.tmp/production-secrets/mqtt_password
SESSION_SECRET_KEY_FILE=./.tmp/production-secrets/session_secret_key
TLS_CERTIFICATE_FILE=./.tmp/production-secrets/tls_certificate.pem
TLS_PRIVATE_KEY_FILE=./.tmp/production-secrets/tls_private_key.pem
