COMPOSE_PROJECT_NAME=mes-packaging

MYSQL_DATABASE=mes_packaging_test
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_API_USER=mes_api
MYSQL_API_PASSWORD=replace-api-password
MYSQL_MIGRATION_USER=mes_migrator
MYSQL_MIGRATION_PASSWORD=replace-migration-password

RABBITMQ_USER=mes_app
RABBITMQ_PASSWORD=replace-rabbitmq-password

SESSION_SECRET_KEY=replace-with-at-least-32-random-characters

MES_WEB_PORT=15173
MES_API_PORT=18000
MES_MYSQL_PORT=13306
MES_RABBITMQ_MANAGEMENT_PORT=15673
MES_MQTT_PORT=11883

