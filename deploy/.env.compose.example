COMPOSE_PROJECT_NAME=mes-packaging

MYSQL_DATABASE=mes_packaging_test
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_API_USER=mes_api
MYSQL_API_PASSWORD=replace-api-password
MYSQL_MIGRATION_USER=mes_migrator
MYSQL_MIGRATION_PASSWORD=replace-migration-password

RABBITMQ_USER=mes_app
RABBITMQ_PASSWORD=replace-rabbitmq-password
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_PUBLISH_TIMEOUT_SECONDS=10
MQTT_PUBLISH_SLOW_MS=250

# Read snapshots invalidate immediately after application writes. The stale
# window only smooths periodic refreshes for unchanged versions.
READ_SNAPSHOT_CACHE_TTL_SECONDS=5.0
READ_SNAPSHOT_CACHE_STALE_SECONDS=30.0

CAPACITY_WARN_POOL_UTILIZATION=0.8
CAPACITY_WARN_STAGING_EVENT_ITEMS=20000
CAPACITY_WARN_STAGING_EVENT_BYTES=16777216
CAPACITY_WARN_MQ_MESSAGE_ROWS=500000
CAPACITY_WARN_EXPERIMENT_EVENT_ROWS=500000

RETENTION_ENABLED=true
RETENTION_STARTUP_DELAY_SECONDS=60
RETENTION_INTERVAL_SECONDS=3600
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES_PER_RUN=10
MQ_MESSAGE_LOG_RETENTION_DAYS=90
EXPERIMENT_EVENT_RETENTION_DAYS=365
STAGING_EVENT_RETENTION_DAYS=365

SESSION_SECRET_KEY=replace-with-at-least-32-random-characters

MES_WEB_PORT=15173
MES_API_PORT=18000
MES_MYSQL_PORT=13306
MES_RABBITMQ_MANAGEMENT_PORT=15673
MES_MQTT_PORT=11883

# Bounded Docker json-file logs for every service in the isolated stack.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Optional registry overrides for restricted networks. Leave unset to use Docker Hub.
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim-bookworm
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
# NGINX_IMAGE=public.ecr.aws/docker/library/nginx:1.28-alpine
# MYSQL_IMAGE=public.ecr.aws/docker/library/mysql:9.6
# RABBITMQ_IMAGE=public.ecr.aws/docker/library/rabbitmq:4.1-management
