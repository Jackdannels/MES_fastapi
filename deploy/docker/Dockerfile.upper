ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONUTF8=1 TZ=Asia/Shanghai
WORKDIR /app
RUN groupadd --system --gid 10001 simulator \
    && useradd --system --uid 10001 --gid simulator --create-home simulator
COPY tools/upper_computer_simulator/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt
COPY --chown=simulator:simulator tools/upper_computer_simulator /app/tools/upper_computer_simulator
USER simulator
EXPOSE 8899
CMD ["python", "-m", "uvicorn", "tools.upper_computer_simulator.runtime:app", "--host", "0.0.0.0", "--port", "8899", "--no-proxy-headers"]
