ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    TZ=Asia/Shanghai

WORKDIR /app

RUN groupadd --system --gid 10001 mes \
    && useradd --system --uid 10001 --gid mes --create-home --home-dir /home/mes mes \
    && mkdir -p /data/reports \
    && chown -R mes:mes /app /data/reports

COPY requirements-prod.txt /tmp/requirements-prod.txt
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r /tmp/requirements-prod.txt

COPY --chown=mes:mes app /app/app
COPY --chown=mes:mes scripts/init_mysql_storage.py /app/scripts/init_mysql_storage.py
COPY --chown=mes:mes scripts/sql/0001-complete-baseline-schema.sql /app/scripts/sql/0001-complete-baseline-schema.sql
COPY --chown=mes:mes scripts/sql/2026-03-17-app-storage-snapshot.sql /app/scripts/sql/2026-03-17-app-storage-snapshot.sql
COPY --chown=mes:mes scripts/sql/2026-03-17-mes-single-branch-schema-alignment.sql /app/scripts/sql/2026-03-17-mes-single-branch-schema-alignment.sql
COPY --chown=mes:mes scripts/sql/V004__runtime_schema_finalization.sql /app/scripts/sql/V004__runtime_schema_finalization.sql
COPY --chown=mes:mes scripts/sql/V005__terminal_collation_alignment.sql /app/scripts/sql/V005__terminal_collation_alignment.sql

USER mes

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips=*"]
