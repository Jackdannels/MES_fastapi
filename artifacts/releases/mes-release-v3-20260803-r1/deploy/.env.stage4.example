COMPOSE_PROJECT_NAME=mes-stage4-rc2-20260802

# All images must already exist locally. Stage4 runs with --no-build --pull never.
MES_API_IMAGE=mes-api:2026.08.02-rc2@sha256:e14e38c26d964910adced0ba4b655b2c1c25c05593f6179ef9a7c0b05fd7858c
MES_WEB_IMAGE=mes-web:2026.08.02-rc2@sha256:06025016c0b896cafc93cb1222f24d33e3ac876c8b1ac9284846e567ede9384d
MYSQL_IMAGE=public.ecr.aws/docker/library/mysql:9.6@sha256:c5df04bee1a42b74a5841c6409e669cf62126cd0416f00c1cea8ab933b9361b9
RABBITMQ_IMAGE=public.ecr.aws/docker/library/rabbitmq:4.1-management@sha256:1c6fbf0d6cd61b3deff3eeb66cc50cf57c8bf429dd67252d80c9fa3d3484d067

MYSQL_DATABASE=mes_stage4_test
MYSQL_ROOT_PASSWORD=replace-stage4-root-password
MYSQL_API_USER=mes_api
MYSQL_API_PASSWORD=replace-stage4-api-password
MYSQL_MIGRATION_USER=mes_migrator
MYSQL_MIGRATION_PASSWORD=replace-stage4-migration-password

RABBITMQ_USER=mes_app
RABBITMQ_PASSWORD=replace-stage4-rabbitmq-password
SESSION_SECRET_KEY=replace-with-at-least-32-random-characters

MES_WEB_PORT=25173
MES_API_PORT=28000
MES_MYSQL_PORT=23306
MES_RABBITMQ_MANAGEMENT_PORT=25673
MES_MQTT_PORT=21883

CAPACITY_WARN_POOL_UTILIZATION=0.8
CAPACITY_WARN_STAGING_EVENT_ITEMS=20000
CAPACITY_WARN_STAGING_EVENT_BYTES=16777216
CAPACITY_WARN_MQ_MESSAGE_ROWS=500000
CAPACITY_WARN_EXPERIMENT_EVENT_ROWS=500000

RETENTION_ENABLED=true
RETENTION_STARTUP_DELAY_SECONDS=5
RETENTION_INTERVAL_SECONDS=60
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES_PER_RUN=10
MQ_MESSAGE_LOG_RETENTION_DAYS=90
EXPERIMENT_EVENT_RETENTION_DAYS=365
STAGING_EVENT_RETENTION_DAYS=365

MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_PUBLISH_TIMEOUT_SECONDS=10
MQTT_PUBLISH_SLOW_MS=250

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

STAGE4_MYSQL_CPUS=1.0
STAGE4_MYSQL_MEMORY_LIMIT=1536m
STAGE4_MYSQL_PIDS_LIMIT=256
STAGE4_RABBITMQ_CPUS=0.5
STAGE4_RABBITMQ_MEMORY_LIMIT=768m
STAGE4_RABBITMQ_PIDS_LIMIT=512
STAGE4_MIGRATE_CPUS=0.5
STAGE4_MIGRATE_MEMORY_LIMIT=512m
STAGE4_MIGRATE_PIDS_LIMIT=128
STAGE4_API_CPUS=0.5
STAGE4_API_MEMORY_LIMIT=768m
STAGE4_API_PIDS_LIMIT=128
STAGE4_WEB_CPUS=0.25
STAGE4_WEB_MEMORY_LIMIT=128m
STAGE4_WEB_PIDS_LIMIT=64
