APP_NAME=MES
# The sample file opts into local debug mode for plain HTTP development.
DEBUG=true
# Default: backend API-only. Set to true only if you want FastAPI to serve frontend/dist for compatibility.
SERVE_WEB_APP=false
# Optional demo login for local environments. Leave unset to disable demo auth.
# DEMO_USER=demo-user
# DEMO_PASSWORD=change-me
SESSION_COOKIE_NAME=mes_session
# Optional override. Defaults to true when DEBUG=false, false when DEBUG=true.
# SESSION_COOKIE_SECURE=true
# Required for signed auth cookies.
# SESSION_SECRET_KEY=replace-with-a-random-secret
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=8
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Frontend dev server should call the backend at http://127.0.0.1:8000 by default.
# Runtime business storage now defaults to MySQL.
STORAGE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# MYSQL_PASSWORD=change-me
MYSQL_DATABASE=mes_single_branch
# Keep true only during migration if you want to seed a completely empty MySQL store
# from app/data/mes_store.json on first boot.
MYSQL_BOOTSTRAP_FROM_JSON=true
MYSQL_AUTO_INIT_SCHEMA=false
MYSQL_AUTO_SEED_DEMO=false

DM_HOST=127.0.0.1
DM_PORT=5236
DM_USER=SYSDBA
DM_PASSWORD=SYSDBA
DM_DATABASE=MES
# DM_DSN=dm://SYSDBA:SYSDBA@127.0.0.1:5236
