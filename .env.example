APP_NAME=MES

# Local development uses plain HTTP and non-secure cookies.
DEBUG=true
APP_ENV=dev

# Default: backend API-only. Set to true only if FastAPI must serve frontend/dist for compatibility.
SERVE_WEB_APP=false

# Optional demo login for local environments. Leave unset to disable demo auth.
# DEMO_USER=demo-user
# DEMO_PASSWORD=change-me

SESSION_COOKIE_NAME=mes_session
# Optional override. Defaults to true when DEBUG=false, false when DEBUG=true.
# SESSION_COOKIE_SECURE=true
# Required for signed auth cookies.
# SESSION_SECRET_KEY=replace-with-a-random-secret
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=8

# Frontend origins allowed by CORS. Add LAN/public frontend origins when exposing the frontend outside this machine.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Container/server deployments should mount this absolute path as a persistent volume.
# TEST_DATA_SAVE_PATH=/data/reports

# Runtime business storage only supports MySQL.
STORAGE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# MYSQL_PASSWORD=change-me
# Dedicated DDL account used only by scripts/init_mysql_storage.py.
# Production deployments must set this account and keep it different from MYSQL_USER.
# MYSQL_MIGRATION_USER=mes_migrator
# MYSQL_MIGRATION_PASSWORD=change-me-too
MYSQL_DATABASE=mes_single_branch
MYSQL_AUTO_INIT_SCHEMA=false
MYSQL_AUTO_SEED_DEMO=false
# External production MySQL should provide a trusted CA and verify the server hostname.
# MYSQL_SSL_CA=/run/secrets/mysql_ca.pem
# MYSQL_SSL_VERIFY_CERT=true
# MYSQL_SSL_VERIFY_IDENTITY=true
# Optional mutual TLS; certificate and key must be configured together.
# MYSQL_SSL_CERT=/run/secrets/mysql_client.pem
# MYSQL_SSL_KEY=/run/secrets/mysql_client.key

# Low-overhead P0 performance observability. Slow requests are logged as JSON.
PERFORMANCE_MONITOR_ENABLED=true
PERFORMANCE_LOG_ALL_REQUESTS=false
PERFORMANCE_SLOW_REQUEST_MS=500
READ_SNAPSHOT_CACHE_TTL_SECONDS=5.0

# MQTT is disabled by default. Enable it only when RabbitMQ/MQTT Broker is available.
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=guest
MQTT_PASSWORD=guest
MQTT_QOS=1
MQTT_TOPIC_PREFIX=mes/v1
# Development/test-only HTTP event injection. Production always rejects this route.
MQTT_HTTP_EVENT_INGRESS_ENABLED=false

# LIMS -> MES business integration uses RabbitMQ AMQP only.
RABBITMQ_ENABLED=true
RABBITMQ_REQUIRED=true
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_COMMAND_EXCHANGE=lims.mes.commands
RABBITMQ_EVENT_EXCHANGE=mes.lims.events
RABBITMQ_DLX_EXCHANGE=lims.mes.dlx
RABBITMQ_INTAKE_QUEUE=mes.external-intake.v1
RABBITMQ_INTAKE_ROUTING_KEY=lims.external-intake.created.v1
RABBITMQ_STATUS_QUEUE=lims.external-intake-status.v1
RABBITMQ_PREFETCH_COUNT=10

# Optional simulator automation for local MQTT integration.
# Leave UPPER_COMPUTER_SIMULATOR_DIR unset to use:
#   <current-user-desktop>/MES_upper_computer_simulator
UPPER_COMPUTER_SIMULATOR_AUTO_ENABLE=false
UPPER_COMPUTER_SIMULATOR_AUTO_START=true
# UPPER_COMPUTER_SIMULATOR_DIR=C:\Users\<your-user>\Desktop\MES_upper_computer_simulator
UPPER_COMPUTER_SIMULATOR_HOST=127.0.0.1
UPPER_COMPUTER_SIMULATOR_PORT=8899
UPPER_COMPUTER_SIMULATOR_URL=http://127.0.0.1:8899
UPPER_COMPUTER_SIMULATOR_DEFAULT_LAB_CODE=LAB_SALT
UPPER_COMPUTER_SIMULATOR_START_TIMEOUT_SECONDS=8

# Dameng database placeholders. MySQL remains the active runtime storage.
DM_HOST=127.0.0.1
DM_PORT=5236
DM_USER=SYSDBA
DM_PASSWORD=SYSDBA
DM_DATABASE=MES
# DM_DSN=dm://SYSDBA:SYSDBA@127.0.0.1:5236
