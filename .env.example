APP_NAME=MES
# The sample file opts into local debug mode for plain HTTP development.
DEBUG=true
# Default: backend API-only. Set to true only if you want FastAPI to serve frontend/dist for compatibility.
SERVE_WEB_APP=false
# Optional demo login for local environments. Leave unset to disable demo auth.
# DEMO_USER=demo-user
# DEMO_PASSWORD=change-me
SESSION_COOKIE_NAME=mes_session
# Optional override. Defaults to true when DEBUG=false, false when DEBUG=true.
# SESSION_COOKIE_SECURE=true
# Required for signed auth cookies.
# SESSION_SECRET_KEY=replace-with-a-random-secret
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=8
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# MySQL-first startup. Keep JSON bootstrap enabled only for the initial empty-state migration.
STORAGE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# MYSQL_PASSWORD=change-me
MYSQL_DATABASE=mes_single_branch
# Keep true only while migrating an empty MySQL store from app/data/mes_store.json.
MYSQL_BOOTSTRAP_FROM_JSON=true

DM_HOST=127.0.0.1
DM_PORT=5236
DM_USER=SYSDBA
DM_PASSWORD=SYSDBA
DM_DATABASE=MES
# DM_DSN=dm://SYSDBA:SYSDBA@127.0.0.1:5236
