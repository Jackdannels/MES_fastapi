APP_NAME=MES

# Local development uses plain HTTP and non-secure cookies.
DEBUG=true
APP_ENV=dev

# Default: backend API-only. Set to true only if FastAPI must serve frontend/dist for compatibility.
SERVE_WEB_APP=false

# Optional demo login for local environments. Leave unset to disable demo auth.
# DEMO_USER=demo-user
# DEMO_PASSWORD=change-me

SESSION_COOKIE_NAME=mes_session
# Optional override. Defaults to true when DEBUG=false, false when DEBUG=true.
# SESSION_COOKIE_SECURE=true
# Required for signed auth cookies.
# SESSION_SECRET_KEY=replace-with-a-random-secret
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=8

# Frontend origins allowed by CORS. Add LAN/public frontend origins when exposing the frontend outside this machine.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Runtime business storage only supports MySQL.
STORAGE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# MYSQL_PASSWORD=change-me
MYSQL_DATABASE=mes_single_branch
MYSQL_AUTO_INIT_SCHEMA=false
MYSQL_AUTO_SEED_DEMO=false

# MQTT is disabled by default. Enable it only when RabbitMQ/MQTT Broker is available.
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=guest
MQTT_PASSWORD=guest
MQTT_QOS=1
MQTT_TOPIC_PREFIX=mes/v1

# Optional simulator automation for local MQTT integration.
# Leave UPPER_COMPUTER_SIMULATOR_DIR unset to use:
#   <current-user-desktop>/MES_upper_computer_simulator
UPPER_COMPUTER_SIMULATOR_AUTO_ENABLE=false
UPPER_COMPUTER_SIMULATOR_AUTO_START=true
# UPPER_COMPUTER_SIMULATOR_DIR=C:\Users\<your-user>\Desktop\MES_upper_computer_simulator
UPPER_COMPUTER_SIMULATOR_HOST=127.0.0.1
UPPER_COMPUTER_SIMULATOR_PORT=8899
UPPER_COMPUTER_SIMULATOR_URL=http://127.0.0.1:8899
UPPER_COMPUTER_SIMULATOR_DEFAULT_LAB_CODE=LAB_SALT
UPPER_COMPUTER_SIMULATOR_START_TIMEOUT_SECONDS=8

# Dameng database placeholders. MySQL remains the active runtime storage.
DM_HOST=127.0.0.1
DM_PORT=5236
DM_USER=SYSDBA
DM_PASSWORD=SYSDBA
DM_DATABASE=MES
# DM_DSN=dm://SYSDBA:SYSDBA@127.0.0.1:5236
